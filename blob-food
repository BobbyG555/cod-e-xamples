
local players = game:GetService("Players")
local tweenservice = game:GetService("TweenService")

local arena = workspace:WaitForChild("BlobArena")

local max_food = 150
local food_respawn = 0.3
local food_count = 0

local food_folder = Instance.new("Folder")
food_folder.Name = "BlobFood"
food_folder.Parent = workspace

local food_types = {
    {
        worth = 1,
        size = 0.7,
        color = Color3.fromRGB(255, 220, 70)
    },
    {
        worth = 3,
        size = 1,
        color = Color3.fromRGB(70, 255, 120)
    },
    {
        worth = 5,
        size = 1.3,
        color = Color3.fromRGB(255, 80, 180)
    }
}

-- gets a random position inside arena
local function random_pos()
    local arena_size = arena.Size
    local arena_pos = arena.Position

    local x = math.random(
        -arena_size.X / 2 + 5,
        arena_size.X / 2 - 5
    )

    local z = math.random(
        -arena_size.Z / 2 + 5,
        arena_size.Z / 2 - 5
    )

    return Vector3.new(
        arena_pos.X + x,
        arena_pos.Y + arena_size.Y / 2 + 1.5,
        arena_pos.Z + z
    )
end

-- makes a food pellet
local function spawn_food()
    if food_count >= max_food then return end

    local food_info = food_types[math.random(1, #food_types)]

    local food = Instance.new("Part")
    food.Name = "Food"
    food.Shape = Enum.PartType.Ball
    food.Size = Vector3.new(0.1, 0.1, 0.1)
    food.Position = random_pos()
    food.Anchored = true
    food.CanCollide = false
    food.CanTouch = true
    food.Material = Enum.Material.Neon
    food.Color = food_info.color
    food.Parent = food_folder

    food_count += 1

    local collected = false

    -- food spawning animation
    local appear = tweenservice:Create(
        food,
        TweenInfo.new(0.25),
        {
            Size = Vector3.new(
                food_info.size,
                food_info.size,
                food_info.size
            )
        }
    )

    appear:Play()

    -- when blob touches food
    food.Touched:Connect(function(hit)
        if collected then return end

        local char = hit:FindFirstAncestorOfClass("Model")
        if not char then return end

        local plr = players:GetPlayerFromCharacter(char)
        if not plr then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        if not char:FindFirstChild("BlobBody") then return end

        collected = true
        food.CanTouch = false

        local old_mass = plr:GetAttribute("Mass") or 10
        plr:SetAttribute("Mass", old_mass + food_info.worth)

        -- food disappears
        local disappear = tweenservice:Create(
            food,
            TweenInfo.new(0.15),
            {
                Size = Vector3.new(0.1, 0.1, 0.1),
                Transparency = 1
            }
        )

        disappear:Play()
        disappear.Completed:Wait()

        food:Destroy()
        food_count -= 1
    end)
end

-- constantly spawns food
while true do
    task.wait(food_respawn)

    if food_count < max_food then
        spawn_food()
    end
end
