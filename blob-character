
local players = game:GetService("Players")
local tweenservice = game:GetService("TweenService")

local starting_mass = 10
local starting_size = 4
local max_blob_size = 35

local normal_speed = 20
local min_speed = 7

local blob_colors = {
    Color3.fromRGB(255, 80, 80),
    Color3.fromRGB(80, 170, 255),
    Color3.fromRGB(100, 255, 120),
    Color3.fromRGB(255, 210, 70),
    Color3.fromRGB(180, 90, 255),
    Color3.fromRGB(255, 110, 210)
}

-- works out how big the blob should be
local function get_blob_size(mass)
    local extra_size = (mass / starting_mass) ^ (1/3)
    local size = starting_size * extra_size

    return math.clamp(size, starting_size, max_blob_size)
end

local function update_blob(plr, char)
    local blob = char:FindFirstChild("BlobBody")
    local hum = char:FindFirstChild("Humanoid")

    if not blob or not hum then return end

    local mass = plr:GetAttribute("Mass") or starting_mass
    local new_size = get_blob_size(mass)

    local new_speed = normal_speed - (new_size * 0.4)
    new_speed = math.clamp(new_speed, min_speed, normal_speed)

    hum.WalkSpeed = new_speed

    local grow_tween = tweenservice:Create(
        blob,
        TweenInfo.new(0.3, Enum.EasingStyle.Sine),
        {
            Size = Vector3.new(new_size, new_size, new_size)
        }
    )

    grow_tween:Play()

    local stats = plr:FindFirstChild("leaderstats")
    if stats then
        local mass_stat = stats:FindFirstChild("Mass")
        if mass_stat then
            mass_stat.Value = math.floor(mass)
        end
    end
end

-- makes the actual blob
local function make_blob(plr, char)
    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")

    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

    -- hides normal character
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Transparency = 1

            if obj ~= root then
                obj.CanCollide = false
            end
        elseif obj:IsA("Decal") then
            obj.Transparency = 1
        end
    end

    local blob = Instance.new("Part")
    blob.Name = "BlobBody"
    blob.Shape = Enum.PartType.Ball
    blob.Size = Vector3.new(4, 4, 4)
    blob.Material = Enum.Material.SmoothPlastic
    blob.Color = blob_colors[math.random(1, #blob_colors)]
    blob.CanCollide = false
    blob.CanTouch = true
    blob.Massless = true
    blob.CFrame = root.CFrame
    blob.Parent = char

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = blob
    weld.Parent = blob

    -- small glow on the blob
    local light = Instance.new("PointLight")
    light.Brightness = 0.4
    light.Range = 10
    light.Color = blob.Color
    light.Parent = blob

    -- name above blob
    local name_gui = Instance.new("BillboardGui")
    name_gui.Name = "BlobName"
    name_gui.Size = UDim2.new(0, 180, 0, 45)
    name_gui.StudsOffset = Vector3.new(0, 3, 0)
    name_gui.AlwaysOnTop = true
    name_gui.Adornee = blob
    name_gui.Parent = blob

    local name_txt = Instance.new("TextLabel")
    name_txt.Size = UDim2.new(1, 0, 1, 0)
    name_txt.BackgroundTransparency = 1
    name_txt.Text = plr.DisplayName
    name_txt.TextColor3 = Color3.new(1, 1, 1)
    name_txt.TextStrokeTransparency = 0
    name_txt.TextScaled = true
    name_txt.Font = Enum.Font.GothamBold
    name_txt.Parent = name_gui

    update_blob(plr, char)
end

-- player setup
players.PlayerAdded:Connect(function(plr)
    plr:SetAttribute("Mass", starting_mass)

    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = plr

    local mass_stat = Instance.new("IntValue")
    mass_stat.Name = "Mass"
    mass_stat.Value = starting_mass
    mass_stat.Parent = stats

    plr.CharacterAdded:Connect(function(char)
        plr:SetAttribute("Mass", starting_mass)

        make_blob(plr, char)
    end)

    -- detects when mass changes
    plr:GetAttributeChangedSignal("Mass"):Connect(function()
        if plr.Character then
            update_blob(plr, plr.Character)
        end
    end)
end)
